{
  "name": "stacmv/kpenv",
  "description": "KeePass-based environment file (.env) manager for secure development workflows",
  "type": "project",
  "license": "MIT",
  "version": "1.1.0",
  "authors": [
    {
      "name": "Human + Claude",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0 || ^13.0",
    "phpstan/phpstan": "^1.10 || ^2.0",
    "pestphp/pest": "^2.0 || ^3.0"
  },
  "autoload": {
    "psr-4": {
      "KpEnv\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "KpEnv\\Tests\\": "tests/"
    }
  },
  "bin": ["kpenv"],
  "scripts": {
    "test": "pest",
    "test:coverage": "pest --coverage"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "keywords": [
    "keepass",
    "environment",
    "dotenv",
    "secrets",
    "security",
    "cli"
  ]
}
