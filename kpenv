#!/usr/bin/env php
<?php
/**
 * kpenv - KeePass-based environment file manager
 *
 * Manages .env files by syncing with KeePassXC password manager
 *
 * @author Human + Claude collaboration
 * @license MIT
 * @version 1.1.0
 */

declare(strict_types=1);

// --- Main Execution ---
// Only run main() if this script is being executed directly (not included for tests)
if (isset($argc) && isset($argv) && realpath($argv[0] ?? '') === __FILE__) {
    main($argc, $argv);
}

class Config
{
    private array $config;

    private const DEFAULTS = [
        'base_dev_folder' => null, // Will use HOME/dev
        'keepass_db' => null, // Will use HOME/Documents/work-secrets.kdbx
        'default_env' => 'development',
        'example_files' => ['.env.example', 'env.example', '.env.dist', 'example.env'],
        'auto_gitignore' => true,
    ];

    public function __construct()
    {
        $this->config = $this->loadConfig();
    }

    private function loadConfig(): array
    {
        // Start with defaults
        $config = self::DEFAULTS;

        // Apply default paths if not set
        $homeDir = getenv('HOME') ?: '/root';
        if ($config['base_dev_folder'] === null) {
            $config['base_dev_folder'] = $homeDir . '/dev';
        }
        if ($config['keepass_db'] === null) {
            $config['keepass_db'] = $homeDir . '/Documents/work-secrets.kdbx';
        }

        // Load user config (~/.kpenv/config.json)
        $userConfigPath = $homeDir . '/.kpenv/config.json';
        if (file_exists($userConfigPath)) {
            $userConfig = json_decode(file_get_contents($userConfigPath), true);
            if (is_array($userConfig)) {
                $config = array_merge($config, $userConfig);
            }
        }

        // Load project config (.kpenv.json in current directory)
        $projectConfigPath = getcwd() . '/.kpenv.json';
        if (file_exists($projectConfigPath)) {
            $projectConfig = json_decode(file_get_contents($projectConfigPath), true);
            if (is_array($projectConfig)) {
                $config = array_merge($config, $projectConfig);
            }
        }

        // Environment variables override
        if ($db = getenv('KPENV_DB')) {
            $config['keepass_db'] = $db;
        }
        if ($base = getenv('KPENV_BASE_FOLDER')) {
            $config['base_dev_folder'] = $base;
        }

        return $config;
    }

    public function get(string $key, $default = null)
    {
        return $this->config[$key] ?? $default;
    }

    public function set(string $key, $value): void
    {
        $this->config[$key] = $value;
    }

    public function getAll(): array
    {
        return $this->config;
    }

    public static function createUserConfig(): bool
    {
        $homeDir = getenv('HOME') ?: '/root';
        $configDir = $homeDir . '/.kpenv';
        $configFile = $configDir . '/config.json';

        // Create directory if it doesn't exist
        if (!is_dir($configDir)) {
            if (!mkdir($configDir, 0755, true)) {
                return false;
            }
        }

        // Don't overwrite existing config
        if (file_exists($configFile)) {
            return true;
        }

        $defaultConfig = [
            'base_dev_folder' => $homeDir . '/dev',
            'keepass_db' => $homeDir . '/Documents/work-secrets.kdbx',
            'default_env' => 'development',
            'example_files' => ['.env.example', 'env.example', '.env.dist', 'example.env'],
            'auto_gitignore' => true,
        ];

        $json = json_encode($defaultConfig, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);
        return file_put_contents($configFile, $json) !== false;
    }

    public static function createProjectConfig(string $projectName, array $environments, ?string $exampleFile = null): bool
    {
        $configFile = getcwd() . '/.kpenv.json';

        // Don't overwrite existing config
        if (file_exists($configFile)) {
            return true;
        }

        $projectConfig = [
            'project_name' => $projectName,
            'environments' => $environments,
        ];

        if ($exampleFile !== null) {
            $projectConfig['example_file'] = $exampleFile;
        }

        $json = json_encode($projectConfig, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);
        return file_put_contents($configFile, $json) !== false;
    }
}

class KeePassXCService
{
    private string $dbPath;
    private string $password;
    private string $cliPath;

    public function __construct(string $dbPath, string $password)
    {
        $this->dbPath = $dbPath;
        $this->password = $password;

        $this->cliPath = trim(shell_exec('command -v keepassxc-cli'));
        if (empty($this->cliPath) || !is_executable($this->cliPath)) {
            throw new Exception("KeePassXC-CLI executable not found or not executable.");
        }

        if (!file_exists($this->dbPath)) {
            throw new Exception("KeePass database not found at {$this->dbPath}");
        }
    }

    public function getEntryNotes(string $entryPath): ?string
    {
        $result = $this->execute(["show", "--attributes", "Notes", $this->dbPath, $entryPath]);
        if ($result['exit_code'] !== 0) {
            return null;
        }
        return $result['stdout'];
    }

    public function setEntryNotes(string $entryPath, string $notesContent): bool
    {
        $groupPath = dirname($entryPath);
        $this->ensureGroupExists($groupPath);

        $check = $this->execute(["show", "-q", $this->dbPath, $entryPath]);

        if ($check['exit_code'] !== 0) {
            $result = $this->execute(["add", "-u", "env", "--notes", "\n\n" . $notesContent, $this->dbPath, $entryPath]);
        } else {
            $result = $this->execute(["edit", "--notes", $notesContent, $this->dbPath, $entryPath]);
        }
        
        if ($result['exit_code'] !== 0) {
            echo "KeePassXC-CLI Error: " . $result['stderr'] . "\n";
            return false;
        }
        return true;
    }

    private function ensureGroupExists(string $groupPath): void
    {
        if ($groupPath === '.' || $groupPath === '/') return;
        $result = $this->execute(["ls", $this->dbPath, $groupPath]);
        if ($result['exit_code'] !== 0) {
            $this->execute(["mkdir", $this->dbPath, $groupPath]);
        }
    }

    private function execute(array $commandParts, string $stdin = ""): array
    {
        $command = array_merge([$this->cliPath], $commandParts);
        $descriptorSpec = [
            0 => ["pipe", "r"], 
            1 => ["pipe", "w"], 
            2 => ["pipe", "w"], 
        ];

        $process = proc_open($command, $descriptorSpec, $pipes);

        if (is_resource($process)) {
            fwrite($pipes[0], $this->password . "\n");
            if (!empty($stdin)) {
                fwrite($pipes[0], $stdin);
            }
            fclose($pipes[0]);

            $stdout = stream_get_contents($pipes[1]);
            fclose($pipes[1]);

            $stderr = stream_get_contents($pipes[2]);
            fclose($pipes[2]);

            $exitCode = proc_close($process);

            return ['stdout' => trim($stdout), 'stderr' => trim($stderr), 'exit_code' => $exitCode];
        }
        throw new Exception("Failed to run keepassxc-cli");
    }
}

function main(int $argc, array $argv): void
{
    $config = new Config();

    if ($argc < 2) {
        show_help($config);
        exit(1);
    }

    $subcommand = $argv[1];
    $options = getopt("", ["env::", "password::"]);
    $env = $options['env'] ?? $config->get('default_env');

    switch ($subcommand) {
        case 'init':
            init_project($config);
            break;
        case 'sync-example':
            $projectName = get_project_name($config);
            sync_example_locally($config, $env);
            break;
        case 'backup-env':
        case 'restore-env':
            $projectName = get_project_name($config);
            if ($projectName === null) {
                echo "Error: Could not determine project name from current directory.\n";
                echo "Run 'kpenv init' to set up this project.\n";
                exit(1);
            }

            // These commands require a password
            $password = getenv('KEEPASS_PASSWORD') ?: ($options['password'] ?? null);
            if ($password === null || $password === false) {
                echo "KeePass database password: ";
                $password = trim(shell_exec('stty -echo; read password; stty echo; echo $password'));
                echo "\n";
            }
            if (empty($password)) {
                echo "Error: Password cannot be empty.\n";
                exit(1);
            }
            try {
                $keepassDb = $config->get('keepass_db');
                $kpService = new KeePassXCService($keepassDb, $password);
            } catch (Exception $e) {
                echo "Error: " . $e->getMessage() . "\n";
                exit(1);
            }

            if ($subcommand === 'backup-env') {
                backup_env_to_keepass($kpService, $projectName, $env, $config);
            } else {
                restore_env_from_keepass($kpService, $projectName, $env, $config);
            }
            break;
        case 'help':
        case '-h':
        case '--help':
            show_help($config);
            break;
        default:
            echo "Error: Unknown subcommand '$subcommand'\n";
            show_help($config);
            exit(1);
    }
}

function init_project(Config $config): void
{
    echo "🔧 Initializing kpenv in current project...\n\n";

    // Ensure user config exists
    Config::createUserConfig();

    // Detect project name
    $currentDir = getcwd();
    $projectName = basename($currentDir);

    // Try to get better project name from git
    if (file_exists('.git') && is_dir('.git')) {
        $gitRemote = trim(shell_exec('git remote get-url origin 2>/dev/null') ?: '');
        if (!empty($gitRemote)) {
            // Extract repo name from git URL
            if (preg_match('#/([^/]+?)(?:\.git)?$#', $gitRemote, $matches)) {
                $projectName = $matches[1];
            }
        }
    }

    echo "Project detected: $projectName\n";
    echo "Current directory: $currentDir\n\n";

    // Ask user to confirm or change project name
    echo "Project name [$projectName]: ";
    $userInput = fgets(STDIN);
    $userInput = $userInput !== false ? trim($userInput) : '';
    if (!empty($userInput)) {
        $projectName = $userInput;
        echo "✓ Using project name: $projectName\n";
    } else {
        echo "✓ Using detected project name: $projectName\n";
    }
    echo "\n";

    // Detect example file
    $exampleFiles = $config->get('example_files', ['.env.example']);
    $exampleFile = null;
    foreach ($exampleFiles as $candidate) {
        if (file_exists($candidate)) {
            $exampleFile = $candidate;
            break;
        }
    }

    if ($exampleFile) {
        echo "✓ Found $exampleFile\n";
    } else {
        echo "⚠ No example file found (tried: " . implode(', ', $exampleFiles) . ")\n";
    }

    // Check if .env exists
    $envExists = file_exists('.env');
    if ($envExists) {
        echo "✓ .env already exists\n";
    } else {
        echo "✓ .env does not exist (will be created)\n";
    }

    // Check KeePass database
    $keepassDb = $config->get('keepass_db');
    echo "✓ KeePass database: $keepassDb\n";

    // Check keepassxc-cli
    $cliPath = trim(shell_exec('command -v keepassxc-cli 2>/dev/null') ?: '');
    if (empty($cliPath)) {
        echo "⚠ Warning: keepassxc-cli not found. Install KeePassXC to use backup/restore features.\n";
    } else {
        echo "✓ keepassxc-cli found: $cliPath\n";
    }

    echo "\n";

    // Ask user to configure environments
    $defaultEnvironments = ['development', 'staging', 'production'];
    echo "Default environments: " . implode(', ', $defaultEnvironments) . "\n";
    echo "Enter environments (comma-separated) or press Enter to use defaults: ";
    $userInput = fgets(STDIN);
    $userInput = $userInput !== false ? trim($userInput) : '';

    if (!empty($userInput)) {
        $environments = array_map('trim', explode(',', $userInput));
        $environments = array_filter($environments); // Remove empty strings
        if (!empty($environments)) {
            echo "✓ Using environments: " . implode(', ', $environments) . "\n";
        } else {
            $environments = $defaultEnvironments;
            echo "✓ Using default environments: " . implode(', ', $environments) . "\n";
        }
    } else {
        $environments = $defaultEnvironments;
        echo "✓ Using default environments: " . implode(', ', $environments) . "\n";
    }
    echo "\n";

    // Check and update .gitignore
    if ($config->get('auto_gitignore', true)) {
        echo "Checking .gitignore...\n";
        $gitignoreNeedsUpdate = true;

        if (file_exists('.gitignore')) {
            $gitignoreContent = file_get_contents('.gitignore');
            // Check if .env is already in gitignore
            if (preg_match('/^\.env$/m', $gitignoreContent) || preg_match('/^\/\.env$/m', $gitignoreContent)) {
                echo "✓ .env already in .gitignore\n";
                $gitignoreNeedsUpdate = false;
            }
        }

        if ($gitignoreNeedsUpdate) {
            echo "⚠ .env not found in .gitignore\n\n";
            echo "Add .env to .gitignore? [Y/n]: ";
            $answer = fgets(STDIN);
            $answer = $answer !== false ? trim($answer) : '';
            if (empty($answer) || strtolower($answer) === 'y') {
                $gitignoreContent = file_exists('.gitignore') ? file_get_contents('.gitignore') : '';
                // Ensure newline at end
                if (!empty($gitignoreContent) && !str_ends_with($gitignoreContent, "\n")) {
                    $gitignoreContent .= "\n";
                }
                $gitignoreContent .= "# Environment files\n.env\n.env.*\n!.env.example\n";
                file_put_contents('.gitignore', $gitignoreContent);
                echo "✓ Added .env to .gitignore\n";
            }
        }
    }

    echo "\n";

    // Create project config
    echo "Create .kpenv.json config? [Y/n]: ";
    $answer = fgets(STDIN);
    $answer = $answer !== false ? trim($answer) : '';
    if (empty($answer) || strtolower($answer) === 'y') {
        if (Config::createProjectConfig($projectName, $environments, $exampleFile)) {
            echo "✓ Created .kpenv.json\n";
        } else {
            echo "⚠ .kpenv.json already exists\n";
        }
    }

    echo "\n";

    // Offer to sync example
    if ($exampleFile && !$envExists) {
        echo "Sync $exampleFile to .env now? [Y/n]: ";
        $answer = fgets(STDIN);
        $answer = $answer !== false ? trim($answer) : '';
        if (empty($answer) || strtolower($answer) === 'y') {
            echo "\n";
            sync_example_locally($config, $config->get('default_env'));
        }
    }

    echo "\n✅ Project initialized successfully!\n\n";
    echo "Next steps:\n";
    if ($envExists) {
        echo "  1. Review your .env file\n";
        echo "  2. Run 'kpenv backup-env' to save to KeePass\n";
    } else if (!$exampleFile) {
        echo "  1. Create .env.example with your configuration keys\n";
        echo "  2. Run 'kpenv sync-example' to create .env\n";
        echo "  3. Run 'kpenv backup-env' to save to KeePass\n";
    } else {
        echo "  1. Edit .env with your values\n";
        echo "  2. Run 'kpenv backup-env' to save to KeePass\n";
    }
    echo "  3. Share KeePass database with your team\n";
}

function parse_env_file(string $filePath): array {
    if (!file_exists($filePath)) return [];
    $lines = file($filePath, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
    $vars = [];
    foreach ($lines as $line) {
        if (str_starts_with(trim($line), '#')) continue;
        if (strpos($line, '=') !== false) {
            list($key) = explode('=', $line, 2);
            $vars[trim($key)] = true;
        }
    }
    return $vars;
}

function parse_env_line(string $line): ?array {
    // Parse a line and return [key, value, hasQuotes, lineType, inline_comment]
    // lineType: 'variable', 'comment', 'empty'

    $trimmed = trim($line);

    if (empty($trimmed)) {
        return ['type' => 'empty', 'line' => $line];
    }

    if (str_starts_with($trimmed, '#')) {
        return ['type' => 'comment', 'line' => $line];
    }

    if (strpos($line, '=') !== false) {
        list($key, $valuePart) = explode('=', $line, 2);
        $key = trim($key);
        $valuePart = ltrim($valuePart); // Only left trim to preserve structure

        $hasQuotes = false;
        $quoteChar = null;
        $value = '';
        $inlineComment = null;

        // Check if value starts with a quote
        if (strlen($valuePart) > 0 && ($valuePart[0] === '"' || $valuePart[0] === "'")) {
            $quoteChar = $valuePart[0];
            $hasQuotes = true;

            // Find the closing quote
            $pos = 1;
            $escaped = false;
            while ($pos < strlen($valuePart)) {
                if ($escaped) {
                    $escaped = false;
                    $pos++;
                    continue;
                }

                if ($valuePart[$pos] === '\\') {
                    $escaped = true;
                    $pos++;
                    continue;
                }

                if ($valuePart[$pos] === $quoteChar) {
                    // Found closing quote
                    $value = substr($valuePart, 1, $pos - 1);

                    // Check for inline comment after closing quote
                    $afterQuote = substr($valuePart, $pos + 1);
                    if (preg_match('/\s*#\s*(.+)$/', $afterQuote, $matches)) {
                        $inlineComment = trim($matches[1]);
                    }
                    break;
                }

                $pos++;
            }
        } else {
            // No quotes - strip inline comments and extract them
            // Look for # preceded by whitespace
            if (preg_match('/^([^#]*?)\s+#\s*(.+)$/', $valuePart, $matches)) {
                $value = rtrim($matches[1]);
                $inlineComment = trim($matches[2]);
            } else {
                $value = rtrim($valuePart);
            }
        }

        return [
            'type' => 'variable',
            'key' => $key,
            'value' => $value,
            'hasQuotes' => $hasQuotes,
            'quoteChar' => $quoteChar ?: '"',
            'inline_comment' => $inlineComment,
            'line' => $line
        ];
    }

    return null;
}

function sync_example_locally(Config $config, string $env): void {
    $defaultEnv = $config->get('default_env');
    $envFile = (".env");
    if ($env !== $defaultEnv) {
        $envFile = ".env.$env";
    }

    // Try to find example file
    $envExampleFile = $config->get('example_file');
    if (!$envExampleFile) {
        $exampleFiles = $config->get('example_files', ['.env.example']);
        foreach ($exampleFiles as $candidate) {
            if (file_exists($candidate)) {
                $envExampleFile = $candidate;
                break;
            }
        }
    }

    if (!$envExampleFile || !file_exists($envExampleFile)) {
        echo "Error: Example file not found. Tried: " . implode(', ', $config->get('example_files', ['.env.example'])) . "\n";
        exit(1);
    }

    echo "Syncing $envExampleFile with local $envFile...\n";

    // Parse existing .env to know which keys already exist
    $localVars = parse_env_file($envFile);

    // Read example file line by line, preserving structure
    $exampleLines = file($envExampleFile, FILE_IGNORE_NEW_LINES);
    $outputLines = [];
    $addedCount = 0;

    // If .env exists, read it first
    $envExists = file_exists($envFile);
    if ($envExists) {
        $outputLines = file($envFile, FILE_IGNORE_NEW_LINES);
    }

    // Track pending comments to display before next variable
    $pendingComments = [];

    // Process example file
    foreach ($exampleLines as $line) {
        $parsed = parse_env_line($line);

        if ($parsed === null) {
            // Unknown line type, skip
            continue;
        }

        if ($parsed['type'] === 'comment') {
            // Accumulate comment for next variable
            $pendingComments[] = $parsed['line'];
            // If .env doesn't exist yet, include comments
            if (!$envExists) {
                $outputLines[] = $line;
            }
            continue;
        }

        if ($parsed['type'] === 'empty') {
            // Empty line resets pending comments (comment block ended)
            $pendingComments = [];
            // If .env doesn't exist yet, include empty lines
            if (!$envExists) {
                $outputLines[] = $line;
            }
            continue;
        }

        if ($parsed['type'] === 'variable') {
            $key = $parsed['key'];

            // Check if this key already exists in local .env
            if (isset($localVars[$key])) {
                // Key exists, skip (and clear pending comments)
                $pendingComments = [];
                continue;
            }

            // Key doesn't exist, prompt user
            // First, display any accumulated comments
            if (!empty($pendingComments)) {
                echo "\n";
                foreach ($pendingComments as $comment) {
                    echo $comment . "\n";
                }
                $pendingComments = [];
            }

            // Display inline comment if present
            if (isset($parsed['inline_comment']) && $parsed['inline_comment'] !== null) {
                echo "# " . $parsed['inline_comment'] . "\n";
            }

            $defaultValue = $parsed['value'];
            if ($defaultValue !== '') {
                echo "New key '$key' found. Enter value (default: $defaultValue): ";
            } else {
                echo "New key '$key' found. Enter value: ";
            }

            $input = fgets(STDIN);
            $value = $input !== false ? trim($input) : '';

            // Track if user entered a custom value or used default
            $usedDefault = false;
            if ($value === '' && $defaultValue !== '') {
                $value = $defaultValue;
                $usedDefault = true;
            }

            // Format the value matching the example file's style
            if ($parsed['hasQuotes']) {
                $quoteChar = $parsed['quoteChar'];
                // Only escape if user entered a new value
                // Default values from the file are already properly escaped
                if ($usedDefault) {
                    $escapedValue = $value;
                } else {
                    $escapedValue = str_replace(['\\', $quoteChar], ['\\\\', '\\' . $quoteChar], $value);
                }
                $outputLines[] = "$key=$quoteChar$escapedValue$quoteChar";
            } else {
                // No quotes in example, don't add quotes
                $outputLines[] = "$key=$value";
            }

            $addedCount++;
        }
    }

    // Write the result
    file_put_contents($envFile, implode("\n", $outputLines) . "\n");
    echo "Sync completed. $addedCount keys added to $envFile.\n";

    // If changes were made, prompt to backup to KeePass
    if ($addedCount > 0) {
        echo "\nWould you like to backup $envFile to KeePass now? [Y/n]: ";
        $answer = trim(fgets(STDIN));

        if ($answer === '' || strtolower($answer) === 'y' || strtolower($answer) === 'yes') {
            echo "\n";

            // Get project name
            $projectName = get_project_name($config);
            if (!$projectName) {
                echo "Error: Could not determine project name. Please run 'kpenv backup-env' manually.\n";
                return;
            }

            // Get KeePass password
            $password = getenv('KEEPASS_PASSWORD');
            if (!$password) {
                echo "KeePass database password: ";
                system('stty -echo 2>/dev/null');
                $password = trim(fgets(STDIN));
                system('stty echo 2>/dev/null');
                echo "\n";
            }

            if (empty($password)) {
                echo "Error: Password is required. You can backup later with: kpenv backup-env\n";
                return;
            }

            // Create KeePass service and backup
            try {
                $kp = new KeePassXCService($config->get('keepass_db'), $password);
                backup_env_to_keepass($kp, $projectName, $env, $config);
            } catch (Exception $e) {
                echo "Error during backup: " . $e->getMessage() . "\n";
                echo "You can try again with: kpenv backup-env\n";
            }
        } else {
            echo "Skipped backup. You can backup later with: kpenv backup-env\n";
        }
    }
}

function backup_env_to_keepass(KeePassXCService $kp, string $project, string $env, Config $config): void
{
    $defaultEnv = $config->get('default_env');
    $envFile = (".env");
    if ($env !== $defaultEnv) {
        $envFile = ".env.$env";
    }

    if (!file_exists($envFile)) {
        echo "Error: Environment file not found: $envFile\n";
        exit(1);
    }

    $notesContent = file_get_contents($envFile);
    $entryPath = "$project/$env";

    echo "Backing up content of $envFile to KeePass entry '$entryPath'...\n";

    if ($kp->setEntryNotes($entryPath, $notesContent)) {
        echo "Successfully backed up environment to KeePass notes.\n";
    } else {
        echo "Error: Failed to backup environment to KeePass.\n";
        exit(1);
    }
}

function restore_env_from_keepass(KeePassXCService $kp, string $project, string $env, Config $config): void
{
    $defaultEnv = $config->get('default_env');
    $envFile = (".env");
    if ($env !== $defaultEnv) {
        $envFile = ".env.$env";
    }

    echo "Restoring environment from KeePass for project '$project' environment '$env'...\n";

    $entryPath = "$project/$env";
    $notesContent = $kp->getEntryNotes($entryPath);

    if ($notesContent === null) {
        echo "Error: Entry '$entryPath' not found or password incorrect.\n";
        exit(1);
    }

    if (file_exists($envFile)) {
        $fetchedFile = "$envFile.fetched";
        echo "Warning: Local file '$envFile' already exists.\n";
        echo "Saving content from KeePass to '$fetchedFile' instead.\n";
        file_put_contents($fetchedFile, $notesContent);
    } else {
        file_put_contents($envFile, $notesContent);
        echo "Generated $envFile successfully!\n";
    }
}

function get_project_name(Config $config): ?string
{
    // First check project config
    $projectName = $config->get('project_name');
    if ($projectName) {
        return $projectName;
    }

    // Try git remote
    if (file_exists('.git') && is_dir('.git')) {
        $gitRemote = trim(shell_exec('git remote get-url origin 2>/dev/null') ?: '');
        if (!empty($gitRemote)) {
            if (preg_match('#/([^/]+?)(?:\.git)?$#', $gitRemote, $matches)) {
                return $matches[1];
            }
        }
    }

    // Try base folder detection
    $baseDevFolder = $config->get('base_dev_folder');
    $currentDir = getcwd();
    if ($baseDevFolder && strpos($currentDir, $baseDevFolder) === 0) {
        $projectPath = substr($currentDir, strlen($baseDevFolder) + 1);
        if (!empty($projectPath)) {
            return $projectPath;
        }
    }

    // Fallback to directory name
    return basename($currentDir);
}

