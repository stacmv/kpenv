    $keepassDb = $config->get('keepass_db');
    $version = "1.1.0";

    echo "kpenv v$version - KeePass Environment Manager\n\n";
    echo "Usage: kpenv <subcommand> [--env=<environment>] [--password=<password>]\n\n";
    echo "Subcommands:\n";
    echo "  init            Initialize kpenv in current project (check .env, .gitignore, create config)\n";
    echo "  sync-example    Create or update local .env file from example file\n";
    echo "  backup-env      Backup a local .env file to KeePass entry notes\n";
    echo "  restore-env     Restore .env file from KeePass entry notes\n";
    echo "  help            Show this help message\n\n";
    echo "Options:\n";
    echo "  --env=<env>     Environment name (default: development)\n";
    echo "  --password=<pw> KeePass password (or use KEEPASS_PASSWORD env var)\n\n";
    echo "Configuration:\n";
    echo "  User config:    ~/.kpenv/config.json\n";
    echo "  Project config: .kpenv.json\n";
    echo "  Base folder:    $baseDevFolder\n";
    echo "  KeePass DB:     $keepassDb\n\n";
    echo "Environment Variables:\n";
    echo "  KEEPASS_PASSWORD    KeePass database password\n";
    echo "  KPENV_DB           Override KeePass database path\n";
    echo "  KPENV_BASE_FOLDER  Override base development folder\n\n";
    echo "Examples:\n";
    echo "  kpenv init                    # Initialize project\n";
